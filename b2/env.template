# B² Network mainnet (op-geth + op-node)
# ./configure.sh && ./create-jwt.sh && ./init-database.sh && docker compose up -d
#
# Official: https://docs.bsquared.network/for-developers/running_rollup_node
# Archive:  https://docs.bsquared.network/for-developers/running_rollup_archive_node
# L1 is B² Hub (chain ID 213), not Ethereum.

### Images ###
OP_GETH_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-geth:v1.101315.2
OP_NODE_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:v1.7.7

### Network ###
EXT_IP=
SEQUENCER_HTTP=https://b2-mainnet.alt.technology/
GETH_SYNC_MODE=full
# archive = state history (default for public RPC); full = pruned state, keeps blocks/receipts/logs
GC_MODE=archive

### Host paths ###
HOST_DATADIR=$HOME/b2-op-geth-data
HOST_OP_NODE_DATADIR=$HOME/b2-op-node-data

### Ports ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=8223
WS_PORT=8224
OP_NODE_RPC_PORT=8225
P2P_PORT=30323
HOST_OP_NODE_P2P_PORT=9233

### RPC ###
GAS_CAP=600000000

