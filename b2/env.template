### op-node L1 (B² Hub) ###
OP_NODE_L1_ETH_RPC=https://hub-rpc.bsquared.network
OP_NODE_L1_BEACON=https://hub-cl-rpc.bsquared.network
OP_NODE_L1_TRUST_RPC=true
OP_NODE_L1_RPC_KIND=standard

### op-node L2 / rollup ###
OP_NODE_LOG_LEVEL=INFO
OP_NODE_L2_ENGINE_KIND=geth
OP_NODE_L2_ENGINE_AUTH=/config/jwt.hex
OP_NODE_L2_ENGINE_RPC=http://b2-op-geth:8551
