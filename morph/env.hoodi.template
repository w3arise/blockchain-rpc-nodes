# Morph Hoodi testnet full node (morph-geth or morph-reth + morph-node)
# ./configure.sh hoodi && ./init-database.sh hoodi && ./create-jwt.sh && docker compose up -d
#
# L1 is Ethereum Hoodi (chain ID 560048), not Sepolia.
# Chain data: $HOME/morph-hoodi-geth-data, $HOME/morph-hoodi-node-data (geth)
#             $HOME/morph-hoodi-reth-data, $HOME/morph-hoodi-reth-node-data (reth)

# Selected client stack. ./configure.sh hoodi geth|reth sets this line.
COMPOSE_FILE=docker-compose.yml

GETH_DATADIR=$HOME/morph-hoodi-geth-data
NODE_DATADIR=$HOME/morph-hoodi-node-data

GETH_IMAGE=ghcr.io/morph-l2/go-ethereum:2.2.8
NODE_IMAGE=ghcr.io/morph-l2/node:0.6.5

# Host port bindings (RPC on localhost only)
RPC_BIND_ADDR=127.0.0.1
METRICS_BIND_ADDR=127.0.0.1

HTTP_HOST_PORT=8441
WS_HOST_PORT=8442
GETH_P2P_PORT=10303
GETH_METRICS_HOST_PORT=16060
NODE_RPC_HOST_PORT=12657
NODE_P2P_PORT=10656
NODE_METRICS_HOST_PORT=12660

EXT_IP=<YOUR_PUBLIC_IP>

# Max blocks for eth_getTransaction* lookups (0 = unlimited)
# Morph default: 2350000 (~1 year of blocks)
GETH_TX_LOOKUP_LIMIT=0

# Geth garbage-collection mode: archive | full
GETH_GCMODE=archive

# RPC gas cap for eth_call/estimateGas (0 = infinite)
GAS_CAP=600000000

MORPH_FLAG=morph-hoodi
# --hoodi selects the Hoodi network (built-in L1 sequencer contract); without it morph-node
# defaults to network=dev and fails. Same for geth and reth.
NODE_EXTRA_FLAGS=--hoodi

L1_CHAIN_ID=560048
L1_ETH_RPC=<YOUR_L1_ETH_RPC>
L1_ETH_BEACON_RPC=<YOUR_L1_ETH_BEACON_RPC>

ROLLUP_CONTRACT=0x57e0e6dde89dc52c01fe785774271504b1e04664

# Must match the snapshot you restore (latest: snapshot-archive-20260630-1)
L1_MSG_START_HEIGHT=3106743

SNAPSHOT_NAME=snapshot-archive-20260630-1

### Reth (alternative client) ###
# Used with COMPOSE_FILE=docker-compose.reth.yml. Reth needs its own datadirs and snapshot;
# a geth datadir cannot be reused.
RETH_IMAGE=ghcr.io/morph-l2/morph-reth:v1.4.1
RETH_CHAIN=hoodi
RETH_DATADIR=$HOME/morph-hoodi-reth-data
RETH_NODE_DATADIR=$HOME/morph-hoodi-reth-node-data
RETH_P2P_PORT=10303
RETH_METRICS_HOST_PORT=16060

# Snapshot name and the three heights come from the same row of the official snapshot
# table (run-morph-node README) and must stay paired.
RETH_SNAPSHOT_NAME=snapshot-archive-reth-20261115-1
RETH_DERIVATION_START_HEIGHT=4017123
RETH_L1_MSG_START_HEIGHT=3931800
RETH_L2_BASE_HEIGHT=11729740
