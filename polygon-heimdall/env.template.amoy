# Polygon PoS Amoy — Heimdall v2 pruned sentry
# ./configure.sh amoy   # copies this file to .env and sets EXT_IP
#
# Ports stay off mainnet (REST 1317 / P2P 26656 / CometBFT 26657).
# polygon-bor Amoy still uses the public Heimdall API unless you point
# HEIMDALL_URL at http://127.0.0.1:1318.
#
# Docs: https://docs.polygon.technology/pos/how-to/full-node/full-node-docker
# Client: https://github.com/0xPolygon/heimdall-v2
# Seeds: https://docs.polygon.technology/pos/reference/seed-and-bootnodes/
# Snapshots: https://docs.polygon.technology/pos/how-to/snapshots/

### Network ###
CHAIN=amoy
HEIMDALL_CHAIN=amoy
CHAIN_ID=heimdallv2-80002
COMPOSE_PROJECT_NAME=polygon-heimdall-amoy
CONTAINER_NAME=heimdall-amoy
MONIKER=heimdall-amoy

# Public IP for P2P advertisement (external_address)
EXT_IP=<YOUR_PUBLIC_IP>

### Host user (container runs as your uid/gid) ###
BUILD_UID=1000
BUILD_GID=1000

### Client image (https://hub.docker.com/r/0xpolygon/heimdall-v2/tags) ###
HEIMDALL_IMAGE=0xpolygon/heimdall-v2:0.12.1

### Host paths ###
HOST_DATADIR=$HOME/polygon-heimdall-amoy-data
SNAPSHOT_TMPDIR=$HOME/polygon-heimdall-amoy-snapshot-tmp

### Ports (host network — these are the listen ports) ###
RPC_BIND_ADDR=127.0.0.1
API_PORT=1318
TM_RPC_PORT=26667
METRICS_BIND_ADDR=127.0.0.1
METRICS_PORT=26670
# CometBFT P2P, public (TCP + UDP)
P2P_PORT=26666

### Retention (patch-config.sh + start flags) ###
PRUNING=default
MIN_RETAIN_BLOCKS=2000000
INDEXER=null

### Bor JSON-RPC on this host (polygon-bor Amoy HTTP port) ###
BOR_RPC_URL=http://127.0.0.1:8755

### Seeds (v0.12.1 Amoy sentry template) ###
# https://docs.polygon.technology/pos/reference/seed-and-bootnodes/
SEEDS=be818a0ebc61a8ffefdfaf4d3fcfed72ca2d7188@34.89.255.109:26656,329e75b6667f91b65d8047387ce83a1c86e71194@34.179.189.75:26656,42b0aa4c784a93c4797ff965d75793e099dc0b11@34.89.119.250:26656,5d532264fe8592bf8c1dc8abfa11ff52b381eb2c@34.89.40.235:26656

### Snapshots (restore-snapshot.sh) ###
# SNAPSHOT_URL=
