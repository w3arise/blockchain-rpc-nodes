# Polygon PoS mainnet — Heimdall v2 pruned sentry
# ./configure.sh mainnet   # copies this file to .env and sets EXT_IP
#
# Bor on this host reads REST at http://127.0.0.1:1317 (polygon-bor HEIMDALL_URL).
# Start Heimdall, wait until catching_up is false, then start Bor.
#
# Docs: https://docs.polygon.technology/pos/how-to/full-node/full-node-docker
# Client: https://github.com/0xPolygon/heimdall-v2
# Seeds: https://docs.polygon.technology/pos/reference/seed-and-bootnodes/
# Snapshots: https://docs.polygon.technology/pos/how-to/snapshots/

### Network ###
CHAIN=mainnet
# [custom] chain in app.toml (mainnet | amoy). Not the CometBFT chain id.
HEIMDALL_CHAIN=mainnet
CHAIN_ID=heimdallv2-137
COMPOSE_PROJECT_NAME=polygon-heimdall
CONTAINER_NAME=heimdall
MONIKER=heimdall-sentry

# Public IP for P2P advertisement (external_address)
EXT_IP=<YOUR_PUBLIC_IP>

### Host user (container runs as your uid/gid) ###
# Set by ./configure.sh
BUILD_UID=1000
BUILD_GID=1000

### Client image (https://hub.docker.com/r/0xpolygon/heimdall-v2/tags) ###
HEIMDALL_IMAGE=0xpolygon/heimdall-v2:0.12.1

### Host paths ###
HOST_DATADIR=$HOME/polygon-heimdall-data
# Snapshot tarballs and the genesis download. Same volume as HOST_DATADIR.
SNAPSHOT_TMPDIR=$HOME/polygon-heimdall-snapshot-tmp

### Ports (host network — these are the listen ports) ###
# REST 1317 is what polygon-bor mainnet calls. Keep it on localhost.
RPC_BIND_ADDR=127.0.0.1
API_PORT=1317
TM_RPC_PORT=26657
METRICS_BIND_ADDR=127.0.0.1
METRICS_PORT=26660
# CometBFT P2P, public (TCP + UDP)
P2P_PORT=26656

### Retention (patch-config.sh + start flags) ###
# App state: default (recent versions). CometBFT blocks: 2_000_000 floor.
# indexer null: /tx and /tx_search stay disabled. Bor does not use them.
PRUNING=default
MIN_RETAIN_BLOCKS=2000000
INDEXER=null

### Bor JSON-RPC on this host (milestone polls; sync continues if Bor is down) ###
BOR_RPC_URL=http://127.0.0.1:8745

### Seeds (v0.12.1 mainnet sentry template) ###
# https://docs.polygon.technology/pos/reference/seed-and-bootnodes/
SEEDS=a0ef6f328949adc077c59ab1f6b03711ae8d32d2@34.185.209.56:26656,f1e632758dfaf616a833900c0b8845bb2547b7c2@34.185.162.14:26656,e49bb5d9cb22943fb2b9f49a4c5d0f773917efaf@34.179.171.228:26656,babb8151d6fae45fcbb9229bd9faba173f3feaf3@35.246.166.189:26656,9c92984a5aad02c43955da94bb0a979a8dadbcfe@34.142.28.190:26656,3643aeae6a5965053709303e97257f62012fdd9c@34.39.56.114:26656,830d44b0d11ab25c9a03135859049d55daf73a03@34.147.169.102:26656,14fc788314a26116559d4852d3703abad39b25e9@35.230.142.203:26656

### Snapshots (restore-snapshot.sh) ###
# Pruned Heimdall tarball. Copy a current URL from the snapshot page.
# SNAPSHOT_URL=
