# Metis Andromeda mainnet (l1dtl + l2geth replica RPC)
#
# Layout follows metis-ansible pins with replica-style DTL tuning (finalized tag,
# legacy URL/L2_RPC/catch-all flags). Setup:
#   1. ./configure.sh
#   2. Edit .env — L1_ETH_RPC and L1_BEACON only (Ethereum mainnet, full history)
#   3. ./configure.sh again   # writes config/l1dtl.env + config/l2geth.env
#   4. Restore l1dtl + l2geth datadirs from AWS EBS snapshots (see README) or sync from scratch
#   5. docker compose up -d

### Images ###
DTL_IMAGE=metisdao/dtl:v0.2.6
L2GETH_IMAGE=metisdao/l2geth:v0.3.9

### Host paths ###
HOST_DTL_DATADIR=$HOME/metis-l1dtl-data
HOST_L2GETH_DATADIR=$HOME/metis-l2geth-data

### Ports ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=28555
WS_PORT=28556
# l2geth default P2P listen; change if another client already uses 30303 on this host (TCP + UDP)
P2P_PORT=30303
DTL_PORT=7878

###############################################################################
# Ethereum L1 — operator must set (DTL reads mainnet via these endpoints)
#
# Not Metis JSON-RPC. Use your own mainnet execution + beacon with full history.
# L1 geth: --rpc.batch-response-max-size=50000000 if DTL hits "response too large".
# After FP_BLOCK, DTL loads batch blobs from L1_BEACON (keep blob retention).
###############################################################################
L1_ETH_RPC="<YOUR_L1_ETH_RPC>"
L1_BEACON="<YOUR_L1_BEACON>"
FP_BLOCK=22482000

###############################################################################
# Metis Andromeda L2 (chain 1088) — DTL (config/l1dtl.env)
###############################################################################
CHAIN_ID=1088
SYNC_L1_BATCH=true
DTL_POLLING_INTERVAL_MS=15000
DTL_TXS_PER_POLL=100
DTL_LOGS_PER_POLL=100
DTL_CATCH_ALL_ERRORS=true
ADDRESSES_URL=https://metisprotocol.github.io/metis-networks/andromeda-mainnet/addresses.json
L2_RPC_ENDPOINT=https://andromeda.metis.io

###############################################################################
# Metis Andromeda L2 (chain 1088) — l2geth (config/l2geth.env)
###############################################################################
GC_MODE=full
MAX_PEERS=50
SEQ_BRIDGE_URL=https://andromeda.metis.io
ROLLUP_STATE_DUMP_PATH=https://metisprotocol.github.io/metis-networks/andromeda-mainnet/state-dump.latest.json
ROLLUP_MAX_CALLDATA_SIZE=40000
RPC_BATCH_LIMIT=0
