# Etherlink mainnet full RPC node (octez-evm-node observer)
# cp env.template .env
# Setup: ./configure.sh && docker compose up -d
#
# Docs: https://docs.etherlink.com/network/evm-nodes/
# Image: https://hub.docker.com/r/tezos/tezos-bare (tags: octez-evm-node-*)
# Snapshots: https://snapshotter-sandbox.nomadic-labs.eu/etherlink-mainnet/
# Network: https://docs.etherlink.com/get-started/network-information/

### Network ###
# mainnet | shadownet
NETWORK=mainnet
# Pin a release tag — https://hub.docker.com/r/tezos/tezos-bare/tags?name=octez-evm-node
EVM_IMAGE=tezos/tezos-bare:octez-evm-node-v0.63
# full:N keeps all SQL history (blocks/txs/blueprints); prunes Irmin state older than N days
HISTORY_MODE=full:1

### Host paths ###
HOST_DATADIR=$HOME/etherlink-data

### Ports ###
RPC_BIND_ADDR=127.0.0.1
# Host → container 8545 (HTTP JSON-RPC; WebSocket at ws://host:port/ws when --ws is set)
HTTP_PORT=42793
