# Core mainnet RPC — geth hash-full (option C: full receipts/logs, pruned state)
# cp env.template .env and configure before running
#
# Setup (snapshot — preferred):
#   1. ./configure.sh
#   2. docker compose build
#   3. ./restore-snapshot.sh
#   4. docker compose up -d
#
# Setup (genesis / P2P — slow):
#   1. ./configure.sh
#   2. docker compose build
#   3. ./init-database.sh
#   4. docker compose up -d
#
# Docs: https://docs.coredao.org/docs/Node/config/rpc-node-config
# Client: https://github.com/coredao-org/core-chain
# Snapshots: https://github.com/coredao-org/core-snapshots

### Network ###
# Public IP for P2P advertisement (--nat extip); required for incoming peers
EXT_IP=

### Geth release (coredao-org/core-chain) — baked into local image at build time ###
GETH_VERSION=v1.0.22

### Host paths ###
# Chain data (docker volume mount target inside container: /data)
HOST_DATADIR=$HOME/core-data

### Ports (host) ###
# P2P default from official mainnet config.toml (ListenAddr = ":35021").
# Docs do not hard-require this port; static peers listen on 35021, bootstrap discport is 35022.
# Changeable — keep compose --port / firewall / NAT in sync (config.toml ListenAddr is overridden by CLI).
P2P_PORT=35021
# RPC default from Core docs (changeable in config.toml / here)
HTTP_PORT=8575
WS_PORT=8576

### Sync / retention (hash-full) ###
# Option C: hash scheme + full GC — keeps blocks/receipts/logs; prunes old state.
# Do not set --pruneancient (drops ancient blocks/receipts).
SYNC_MODE=full
GCMODE=full
STATE_SCHEME=hash
# 0 = entire chain tx index (needed for historical eth_getTransaction*)
HISTORY_TRANSACTIONS=0
CACHE=8000
MAX_PEERS=100
VERBOSITY=3

### Snapshot (restore-snapshot.sh) ###
# Official pruned (state) mainnet snapshot — not tip-only block prune.
# Check https://github.com/coredao-org/core-snapshots for newer links.
SNAPSHOT_URL=https://snap.coredao.org/coredao-snapshot-mainnet-20251118-pruned.tar.lz4
SNAPSHOT_MD5=cd736e929ca03187211d3c2e4f18358a

### RPC ###
HTTP_API=eth,net,web3,txpool
WS_API=eth,net,web3,txpool
GAS_CAP=600000000
