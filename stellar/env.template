# Stellar mainnet RPC node (stellar-rpc + captive stellar-core)
# cp env.template .env
# Setup: ./configure.sh && docker compose up -d
#
# Native Stellar JSON-RPC (Soroban + general tx APIs) — not Ethereum JSON-RPC.
# Docs: https://developers.stellar.org/docs/data/apis/rpc/admin-guide/running
# Image: https://hub.docker.com/r/stellar/stellar-rpc

### Network ###
# pubnet | testnet — selects built-in network preset (passphrase, history archives, captive-core config)
STELLAR_NETWORK=pubnet
# Pin image tag — https://github.com/stellar/stellar-rpc/releases
STELLAR_RPC_IMAGE=stellar/stellar-rpc:28.0.1

### Host paths ###
# Captive Core buckets + RPC SQLite DB (~350 GiB at default 7-day retention; +~40 GiB per extra day)
HOST_DATADIR=$HOME/stellar-data

### Ports ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=8000
ADMIN_PORT=6061

### Retention ###
# Ledgers retained for getEvents / getTransactions / getLedgers (~5s per ledger).
# Default 120960 ≈ 7 days. SDF recommends keeping RPC retention ≤ 7 days.
HISTORY_RETENTION_WINDOW=120960
