# Polygon PoS mainnet — Bor (geth fork, PBSS + archive GC)
# ./configure.sh mainnet   # copies this file to .env and sets EXT_IP
#
# Docs: https://docs.polygon.technology/pos/how-to/full-node/full-node-docker
# Client: https://github.com/0xPolygon/bor
# Seeds: https://docs.polygon.technology/pos/reference/seed-and-bootnodes/
# Snapshots: https://docs.polygon.technology/pos/how-to/snapshots/

### Network ###
CHAIN=mainnet
COMPOSE_PROJECT_NAME=polygon-bor
CONTAINER_NAME=bor
BOR_CONFIG=mainnet-config.toml

# Public IP for P2P advertisement (--nat extip); required for incoming peers
EXT_IP=

# Heimdall REST API (required). Host networking: localhost is the Docker host.
HEIMDALL_URL=http://127.0.0.1:1317

### Client image (https://hub.docker.com/r/0xpolygon/bor/tags) ###
BOR_IMAGE=0xpolygon/bor:2.10.0

### Host paths ###
HOST_DATADIR=$HOME/polygon-bor-data

### Ports (host network — these are the listen ports) ###
RPC_BIND_ADDR=0.0.0.0
HTTP_PORT=8745
WS_PORT=8746
P2P_PORT=30304

# Official mainnet seeds + older seeds from the previous node (union)
# https://docs.polygon.technology/pos/reference/seed-and-bootnodes/
BOOTNODES=enode://0cb82b395094ee4a2915e9714894627de9ed8498fb881cec6db7c65e8b9a5bd7f2f25cc84e71e89d0947e51c76e85d0847de848c7782b13c0255247a6758178c@44.232.55.71:30303,enode://88116f4295f5a31538ae409e4d44ad40d22e44ee9342869e7d68bdec55b0f83c1530355ce8b41fbec0928a7d75a5745d528450d30aec92066ab6ba1ee351d710@159.203.9.164:30303,enode://48e6326841ce106f6b4e229a1be7e98a1d12be57e328b08cb461f6744ae4e78f5ec2340996ce9b40928a1a90137aadea13e25ca34774b52a3600d13a52c5c7bb@34.185.209.56:30303,enode://8ab6905fe76aa9001adb77135250e918db888cac216870c0e95cf26650d83d31d8c2c93d54c3333e0a2196517c41651d174b743ec3e11f44e595f62b77fec7ba@34.185.162.14:30303,enode://02e0b33cf60fb1f88f853c7c04830156151f4acd1c36173cd3fe1f375801fb4f5be5b3a89c98527915d37ed217752933c3faf4c820df740c9dd681294caebcf6@34.179.171.228:30303,enode://079c387b65b09674825462ea63c528ca996af7b03d19b1b2ab6557347434838067db6dd7ae5e0c2e08d5ba164117f3d7faffbf3e890cb91cffbdf45a433ddfce@35.246.166.189:30303,enode://191d06720948ae0119343e5798098f5b1f95a308174c4119d226da91833bc0176009bcc8bf5012e490500562d4d5b5427c307b01f3485b2e8351ac5afd946864@34.142.28.190:30303,enode://30a4651b245e9a0cec674b9ecb5a06ca01553aa727e14a77d0f1ccdb9e48a975f3be631505f417aae438be545ac3b290cd3ed00bef96efd7fb0fb7f916397b3f@34.39.56.114:30303,enode://b950b98b92e118551d79c7280b97ddfcdf3dacb620367ebd45e8382f8e69390df192055386221025ffd3c03912da2aadf668ae6ea7b35f391d82ef87452b3f02@34.147.169.102:30303,enode://92ef18168f6c281a313d0ca76d6122b913a101352b5069af9cea6c8dd0f8b51d669601d59fdf250e972cf9a547d8a10f21ecf5b99ce8511605f328e5f66e845f@34.105.180.11:30303,enode://5f6232dc546bf615c7b5bc1c896323340892a1c41097a89a1d38385a5d48bb02f9023377e526911a9da6e4112415aa9f3803cbeeef8243a2bfc4a3d0219ae69e@35.230.142.203:30303
DISCOVERY_DNS=enrtree://AKUEZKN7PSKVNR65FZDHECMKOJQSGPARGTPPBI7WS2VUL4EGR6XPC@pos.polygon-peers.io

### Sync / retention (PBSS archive with bounded state history) ###
# Path scheme + archive GC: full receipts/logs; state history via BOR_HISTORY_STATE.
# Official bor archive package uses hash scheme — do not mix path/hash on one datadir.
BOR_DB_ENGINE=pebble
BOR_STATE_SCHEME=path
BOR_SYNCMODE=full
BOR_GCMODE=archive
# Number of recent blocks to maintain log search index for (default ~2 months / 2350000; 0 = entire chain)
BOR_HISTORY_LOGS=40000000
# Number of recent blocks to retain state history for, path scheme only (1296000 ≈ 1 month, default 90000; 0 = entire chain)
BOR_HISTORY_STATE=8296000
# Number of recent blocks to maintain transactions index for (default ~2 months / 2350000; 0 = entire chain)
BOR_HISTORY_TRANSACTIONS=0

### RPC ###
GAS_CAP=600000000
RPC_TX_FEE_CAP=0
RPC_RETURNDATA_LIMIT=70000000
HTTP_API=eth,net,web3,bor
WS_API=eth,net,web3,bor
# false = contract/tx logs via eth_getLogs (BOR_HISTORY_LOGS). true only adds
# Polygon state-sync / bridge system logs, not needed here.
BOR_LOGS=false

### Performance (runtime / container) ###
CACHE=16384
GOGC=80
MEM_LIMIT=48G
GO_MEM_LIMIT=48GiB
CPU_COUNT_LIMIT=32
STOP_GRACE_PERIOD=5m
