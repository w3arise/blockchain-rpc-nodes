# Polygon PoS mainnet — Bor (geth fork, PBSS + archive GC)
# cp env.template .env and configure before running
#
# Setup:
#   1. ./configure.sh                 # create .env, set EXT_IP, mkdir datadir
#   2. Set HEIMDALL_URL to a synced Heimdall v2 REST API
#   3. docker compose pull
#   4. docker compose up -d
#
# Docs: https://docs.polygon.technology/pos/how-to/full-node/full-node-docker
# Client: https://github.com/0xPolygon/bor
# Snapshots: https://docs.polygon.technology/pos/how-to/snapshots/

### Network ###
# Public IP for P2P advertisement (--nat extip); required for incoming peers
EXT_IP=

# Heimdall REST API (required). Host networking: localhost is the Docker host.
HEIMDALL_URL=http://127.0.0.1:1317

### Client image (https://hub.docker.com/r/0xpolygon/bor/tags) ###
BOR_IMAGE=0xpolygon/bor:2.10.0

### Host paths ###
HOST_DATADIR=$HOME/polygon-bor-data

### Ports (host network — these are the listen ports) ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=8745
WS_PORT=8746
P2P_PORT=30304

### Sync / retention (PBSS archive with bounded state history) ###
# Path scheme + archive GC: full receipts/logs; state history via HISTORY_STATE.
# Official bor archive package uses hash scheme — do not mix path/hash on one datadir.
BOR_DB_ENGINE=pebble
BOR_STATE_SCHEME=path
BOR_SYNCMODE=full
BOR_GCMODE=archive
# 0 = entire chain tx index (needed for historical eth_getTransaction*)
HISTORY_TRANSACTIONS=0
# Log search index (~2s blocks). 40000000 ≈ 2.5 years; 0 = entire chain.
HISTORY_LOGS=40000000
# Path-scheme state history. 8296000 ≈ 6 months; 0 = entire chain.
HISTORY_STATE=8296000

### RPC ###
GAS_CAP=600000000

### Performance (runtime / container) ###
GOGC=80
MEM_LIMIT=48G
GO_MEM_LIMIT=48GiB
CPU_COUNT_LIMIT=32
