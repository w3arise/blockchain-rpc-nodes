# Polygon PoS Amoy testnet — Bor (geth fork, PBSS + archive GC)
# ./configure.sh amoy   # copies this file to .env and sets EXT_IP
#
# Docs: https://docs.polygon.technology/pos/how-to/full-node/full-node-docker
# Client: https://github.com/0xPolygon/bor
# Seeds: https://docs.polygon.technology/pos/reference/seed-and-bootnodes/
# Snapshots: https://docs.polygon.technology/pos/how-to/snapshots/

### Network ###
CHAIN=amoy
COMPOSE_PROJECT_NAME=polygon-bor-amoy
CONTAINER_NAME=bor-amoy
BOR_CONFIG=amoy-config.toml

# Public IP for P2P advertisement (--nat extip); required for incoming peers
EXT_IP=

# Polygon public Amoy Heimdall REST (no local Heimdall required)
HEIMDALL_URL=https://heimdall-api-amoy.polygon.technology

### Client image (https://hub.docker.com/r/0xpolygon/bor/tags) ###
BOR_IMAGE=0xpolygon/bor:2.10.0

### Host paths ###
HOST_DATADIR=$HOME/polygon-bor-amoy-data

### Ports (host network — these are the listen ports) ###
RPC_BIND_ADDR=0.0.0.0
HTTP_PORT=8545
WS_PORT=8546
P2P_PORT=31304

# Official Amoy seeds + DNS discovery
# https://docs.polygon.technology/pos/reference/seed-and-bootnodes/
BOOTNODES=enode://8b62d23881dddc0ea26e88f3b15b4d3a04a6dc4480bec4b2121aff02126d4a0fb50032880772a0a7cfe408938a3863c6635d6f674298255c54a4cbef1ad0992c@34.89.255.109:30303,enode://9fa548b9d1c6760df0f80214d354dffd008a1d56509e4bd12342c84322b5c974b71d38275401a8ca0f2b24437e8609975be1de906090234e84e986739e0f82b3@34.89.119.250:30303,enode://26f30c60179b60d976f0ff2f7e197147479a9609fa38af13a7168f0bfeb842adad8750bc3f8e8d46ceacf2071981c492c2bb6760537ca0eb870e9aece7a59b31@34.89.40.235:30303,enode://c4245ae8a1b7c4452b24c9d0384ed47c6bb657f3d23d0cc62bccee54d71d1b5fc76225693474070feaa834780a5b274126aef56c2f4f4537cbe81478e45ac242@34.179.189.75:30303
DISCOVERY_DNS=enrtree://AKUEZKN7PSKVNR65FZDHECMKOJQSGPARGTPPBI7WS2VUL4EGR6XPC@amoy.polygon-peers.io

### Sync / retention (PBSS archive with bounded state history) ###
# Path scheme + archive GC: full receipts/logs; state history via BOR_HISTORY_STATE.
# Official bor archive package uses hash scheme — do not mix path/hash on one datadir.
BOR_DB_ENGINE=pebble
BOR_STATE_SCHEME=path
BOR_SYNCMODE=full
BOR_GCMODE=archive
BOR_HISTORY_LOGS=40000000
BOR_HISTORY_STATE=8296000
BOR_HISTORY_TRANSACTIONS=0

### RPC ###
GAS_CAP=1000000000
RPC_TX_FEE_CAP=0
RPC_RETURNDATA_LIMIT=70000000
HTTP_API=eth,net,web3,bor
WS_API=eth,net,web3,bor
# false = contract/tx logs via eth_getLogs (BOR_HISTORY_LOGS). true only adds
# Polygon state-sync / bridge system logs, not needed here.
BOR_LOGS=false

### Performance (runtime / container) ###
CACHE=8192
GOGC=80
MEM_LIMIT=24G
GO_MEM_LIMIT=24GiB
CPU_COUNT_LIMIT=12
STOP_GRACE_PERIOD=5m
