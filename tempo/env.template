# Tempo mainnet archive RPC node (tempo — Reth SDK + Simplex BFT)
# cp env.template .env
# Setup: ./configure.sh && ./restore-snapshot.sh && docker compose up -d
#
# Docs: https://docs.tempo.xyz/guide/node/rpc
# Image: https://github.com/tempoxyz/tempo/pkgs/container/tempo
# Snapshots: https://snapshots.tempoxyz.dev/

### Network ###
CHAIN=mainnet
# Official image tag (no "v" prefix) — https://github.com/tempoxyz/tempo/releases
TEMPO_IMAGE=ghcr.io/tempoxyz/tempo:1.11.0

# Upstream WebSocket for --follow (required for RPC follower mode; v1.11+ expects WS)
FOLLOW_URL=wss://rpc.tempo.xyz

# Public IP for P2P advertisement (--nat=extip); filled by configure.sh
EXT_IP=

### Host paths ###
# Execution (+ default consensus) data — must be local NVMe on the host
HOST_DATADIR=$HOME/tempo-data
# Optional: put consensus on a separate (slower) volume
# HOST_CONSENSUS_DATADIR=$HOME/tempo-consensus-data

### Ports ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=42175
WS_PORT=42176
# Execution P2P (TCP + UDP, public)
P2P_PORT=30303
# Prometheus metrics (localhost)
METRICS_PORT=9000

### RPC ###
HTTP_API=eth,net,web3,txpool,trace,debug
WS_API=eth,net,web3,txpool,trace,debug
GAS_CAP=600000000

### Snapshot ###
# archive | full | minimal — archive for public historical RPC
SNAPSHOT_PROFILE=archive
