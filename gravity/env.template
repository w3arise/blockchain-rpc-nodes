# Gravity Mainnet L1 public full node (gravity_node / gravity-reth)
# Chain ID 127001. ./configure.sh && ./restore-snapshot.sh && docker compose up -d
#
# Image: Galxe/gravity-sdk stable tags. Not paradigmxyz/reth.
# Hardfork times are compiled into the binary.

GRAVITY_IMAGE=ghcr.io/galxe/gravity_node:v1.9.3
# genesis.json + waypoint.txt are fetched from this gravity-sdk tag (match the image).
GRAVITY_SDK_REF=v1.9.3
RUST_LOG=info

# Archive receipts/logs. Account and storage history are pruned below.
# Do not set full: gravity-reth --full also drops receipts to ~10064 blocks.
NODE_TYPE=archive
PRUNE_ACCOUNT_HISTORY_DISTANCE=10064
PRUNE_STORAGE_HISTORY_DISTANCE=10064

### Ports ###
# network_mode: host — these are the ports gravity_node binds on the host.
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=12745
WS_PORT=12746
METRICS_BIND_ADDR=127.0.0.1
METRICS_PORT=12790
# Aptos public-network P2P (TCP). Seeds listen on 6180; this is the local listen port.
PUBLIC_PORT=26180
# gravity-reth execution P2P (TCP + UDP).
RETH_P2P_PORT=12724
INSPECTION_PORT=12791
AUTHRPC_PORT=12761

### Network ###
EXT_IP=<YOUR_PUBLIC_IP>

### RPC ###
GAS_CAP=600000000
HTTP_API=debug,eth,net,trace,txpool,web3,rpc
TXPOOL_MAX_ACCOUNT_SLOTS=64

### Datadir ###
HOST_DATADIR=$HOME/gravity-data
HOST_LOGDIR=$HOME/gravity-logs

### Snapshot ###
SNAPSHOT_URL=https://gravity-snapshots.b-cdn.net/gravity-mainnet-data/latest.tar
