# BSC (Binance Smart Chain) Node Configuration
# ./configure.sh  # creates .env, sets EXT_IP from ip.me
# docker compose up -d

# Docker Image (BSC geth fork)
# https://github.com/bnb-chain/bsc/pkgs/container/bsc
BSC_IMAGE=ghcr.io/bnb-chain/bsc:1.7.8

# Host path for chain data (used in volume mount)
# Leave unset to use $HOME/chain-data (resolved when you run docker compose)
# Set to a full path to override (e.g. /data/bsc-chain)
# HOST_DATADIR=$HOME/chain-data

# Network - set your external IP for P2P (required for incoming connections)
# network_mode: host — geth binds with --http.addr / --ws.addr / --metrics.addr
HTTP_PORT=8045
WS_PORT=8046
P2P_PORT=30307
PPROF_PORT=6065
METRICS_PORT=6161
MAX_PEERS=100
EXT_IP=<YOUR_PUBLIC_IP>

# Sync mode (full, snap, light)
SYNC_MODE=full
# GC mode (full, archive)
GCMODE=archive
# HISTORY_BLOCKS=63072000 # About 1 year at 2 blocks per second
# History blocks - number of blocks to maintain block index for (default = 0 entire chain)
HISTORY_BLOCKS=0
# History transactions - number of blocks to maintain tx index for (default[2350000] ,0 = entire chain)
HISTORY_TRANSACTIONS=0
# History logs - number of blocks to maintain log index for (default = 600,000 blocks, 0 = entire chain)
HISTORY_LOGS=0
# History state - number of blocks to maintain state index for (default = 600,000 blocks, 0 = entire chain)
HISTORY_STATE=17000000



# RPC APIs
HTTP_API=eth,net,web3,debug
WS_API=eth,net,web3,debug

# RPC limits (0 = no limit)
TX_FEE_CAP=0
GAS_CAP=600000000  # DRPC Recommended 600M gas cap
RPC_BATCH_MAX_SIZE=300000000
RPC_EVM_TIMEOUT=10s

# Tx pool
TXPOOL_LOCALS=0xA1e96Ecaab9d97Bd17583966963C486cf856B639
TXPOOL_PRICE_LIMIT=50000000
MINER_GASPRICE=50000000 # Miner (used for tx pool filtering)


# Performance (runtime / container)
CACHE=57344
GOGC=80
MEM_LIMIT=128g # RAM + swap will never exceed this limit
GO_MEM_LIMIT=128GiB # Go memory limit (used for GC)
CPU_COUNT_LIMIT=32



