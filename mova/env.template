# Mova Mainnet (chain ID 61901) sync node — pruning=syncable, sync from genesis
# cp env.template .env and configure before running
#
# Setup:
#   1. ./configure.sh
#   2. ./init-database.sh
#   3. ./patch-config.sh
#   4. docker compose up -d
#
# Genesis sync must use the binary the chain was created with.
# movachain/movan-syncnode:v0.0.1 (commit 6f0cc05) is that image: the only
# published tag, pushed the day after genesis, and it matches live
# web3_clientVersion mova/0.0.1+6f0cc05. No upstream release notes name a
# later genesis binary. Do not point a fresh datadir at a newer tag unless
# that tag's release notes say it can still sync from height 0.
#
# The vendor image's supervisord passes --pruning=nothing (archive). This
# setup overrides that with PRUNING=syncable. Do not change pruning after
# the first start.
#
# Image: https://hub.docker.com/r/movachain/movan-syncnode
# Chain 61900 (movachain/mainnet-syncnode) is a different network.

### Network ###
CHAIN_ID=61901
MONIKER=mova-rpc

# Public IP for P2P advertisement (external_address).
# Quoted so `source .env` does not treat "<" as a redirect.
EXT_IP="<YOUR_PUBLIC_IP>"

### Host user (compose user:) ###
# Set by ./configure.sh
BUILD_UID=1000
BUILD_GID=1000

### movad image (movachain/movan-syncnode) ###
# Genesis binary. linux/amd64 only.
MOVA_VERSION=v0.0.1

### Host paths ###
# Chain data (container home: /data)
# Leave unset to use $HOME/mova-data
# HOST_DATADIR=$HOME/mova-data

### Ports ###
# JSON-RPC / CometBFT RPC bind on localhost by default.
# HTTP_PORT / WS_PORT are host ports. Inside the container they map to
# movad's JSON-RPC on 9545 / 9546. movacli still listens on 8545 / 8546
# and is not published: its eth_getLogs path rejects the "latest" tag.
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=8545
WS_PORT=8546
TM_RPC_PORT=26657
# P2P (TCP + UDP), public. Shipped config dials persistent peers only
# (pex=false, max_num_inbound_peers=0).
P2P_PORT=26656

### app.toml / noderpc.toml (applied by patch-config.sh) ###
# syncable = full blocks/receipts/logs; state pruned (last 100 + every 10000th)
# nothing   = archive state
# everything = tip state only — do not use for historical log RPC
PRUNING=syncable
# CometBFT tx indexer
INDEXER=kv
# eth_getLogs caps (same defaults as other Cosmos EVM nodes in this repo)
LOGS_CAP=100000
BLOCK_RANGE_CAP=100000
# eth_call / estimateGas cap when the caller omits gas (repo default 600M)
GAS_CAP=600000000

### movacli rest-server (internal, not the published RPC) ###
READ_TIMEOUT=60
WRITE_TIMEOUT=60
RPC_API=eth,net,web3,debug

### Peers (patched into movad init config.toml) ###
# movad init writes max_packet_msg_payload_size = 1024. That drops every peer:
# amino overhead makes the read cap 1047, and peers send larger packets.
# pex / max_num_inbound_peers stay at movad init defaults unless you add them after testing.
MAX_PACKET_MSG_PAYLOAD_SIZE=1024000
PERSISTENT_PEERS=f77e8f83d969720756fa1a74625db3be2737da2e@p2p.movan.movachain.com:59001,6fce7fd1d5d703af81428703ad20413c53172b76@p2p.movan.movachain.com:59002,177a0e675dff8308b99b9da6600f125dfeff6b38@p2p.movan.movachain.com:59003
