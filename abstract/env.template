# Abstract mainnet external node (ZK Stack)
# cp env.template .env && ./configure.sh && docker compose up -d
#
# Chain data: $HOME/abstract-postgres-data, $HOME/abstract-rocksdb-data

NETWORK=mainnet
# Pin from Abstract helm charts/abstract-node/values.yaml (image.tag + image.digest)
EN_VERSION=9734bf2-1787057993929
EN_DIGEST=sha256:5dadc06bdf3bb09b7ac508e6761e164bca22fae09860cf8bc57041302f80f40b
EN_MAIN_NODE_URL=https://api.mainnet.abs.xyz
EN_L1_CHAIN_ID=1
EN_L2_CHAIN_ID=2741
EN_SNAPSHOTS_OBJECT_STORE_BUCKET_BASE_URL=raas-abstract-mainnet-external-node-snapshots

# Required — use your own Ethereum mainnet JSON-RPC
EN_ETH_CLIENT_URL=<YOUR_L1_ETH_RPC>

# Change before production use
DB_PASSWORD=notsecurepassword

# Postgres pool (EN client). Postgres itself allows 200 connections.
DATABASE_POOL_SIZE=50
EN_POSTGRES_STATEMENT_TIMEOUT=60s

# RPC ports (localhost only)
RPC_BIND_ADDR=127.0.0.1
EN_HTTP_PORT=3060
EN_WS_PORT=3061
EN_HEALTHCHECK_PORT=3081
EN_PROMETHEUS_PORT=3322

### RPC ###
# Heavy eth_getLogs / receipts / eth_call over large ranges (binary defaults are much tighter).
EN_REQ_ENTITIES_LIMIT=50000
EN_MAX_RESPONSE_BODY_SIZE_MB=100
EN_MAX_RESPONSE_BODY_SIZE_OVERRIDES_MB=eth_getLogs=100,eth_getBlockReceipts=None
EN_ETH_CALL_GAS_CAP=600000000

# Snapshot recovery — set false to sync from genesis (slow)
EN_SNAPSHOTS_RECOVERY_ENABLED=true

# Pruning — set false for full archive (storage grows ~1 TB/month on mainnet)
EN_PRUNING_ENABLED=true
EN_PRUNING_DATA_RETENTION_SEC=2592000  # 30 days
