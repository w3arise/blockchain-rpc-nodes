# Mantle mainnet (mantle-op-geth + mantle-op-node, hash-full)
#
# Setup:
#   1. ./configure.sh                 # create .env and set public IP
#   2. Edit .env: OP_NODE_L1_ETH_RPC, OP_NODE_L1_BEACON
#   3. ./create-jwt.sh
#   4. ./restore-snapshot.sh          # official full (state-pruned) chaindata
#   5. docker compose up -d
#
# Official compose: mantlenetworkio/networks docker-compose-mainnetv2-upgrade-beacon.yml
# Pins: mantle-op-geth / mantle-op-node v1.5.4 — not generic OP Labs images.

### Images ###
OP_GETH_IMAGE=mantlenetworkio/mantle-op-geth:v1.5.4
OP_NODE_IMAGE=mantlenetworkio/mantle-op-node:v1.5.4

### Network ###
# Public IP for P2P advertisement (--nat extip / OP_NODE_P2P_ADVERTISE_IP)
EXT_IP=
SEQUENCER_HTTP=https://rpc.mantle.xyz
NETWORK_ID=5000
GETH_SYNC_MODE=full
# Hash full: blocks/receipts/logs retained; old state pruned. Do not set archive on this datadir.
GC_MODE=full
# 0 = keep the tx hash index for the whole chain (eth_getTransactionByHash / Receipt).
TXLOOKUP_LIMIT=0

### Host paths ###
HOST_DATADIR=$HOME/mantle-op-geth-data
HOST_OP_NODE_DATADIR=$HOME/mantle-op-node-data

### Ports (host → container 8545 / 8546 / op-node RPC) ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=8541
WS_PORT=8542
OP_NODE_RPC_PORT=8543
OP_NODE_P2P_PORT=10419
P2P_PORT=10417

### RPC ###
GAS_CAP=600000000

### op-node L1 ###
OP_NODE_L1_ETH_RPC=<YOUR_L1_ETH_RPC>
OP_NODE_L1_BEACON=<YOUR_L1_BEACON>
OP_NODE_L1_TRUST_RPC=true
OP_NODE_L1_RPC_KIND=standard

### op-node L2 / rollup ###
OP_NODE_LOG_LEVEL=INFO
OP_NODE_L2_ENGINE_KIND=geth
OP_NODE_L2_ENGINE_AUTH=/config/jwt.hex
OP_NODE_L2_ENGINE_RPC=http://mantle-op-geth:8551
OP_NODE_L2_ENGINE_SYNC_ENABLED=true
OP_NODE_L2_SKIP_SYNC_START_CHECK=true
OP_NODE_ROLLUP_CONFIG=/config/rollup.json
OP_NODE_L2_BACKUP_UNSAFE_SYNC_RPC=https://rpc.mantle.xyz
OP_NODE_RPC_ADDR=0.0.0.0
OP_NODE_RPC_ENABLE_ADMIN=true
OP_NODE_SAFEDB_PATH=/data
OP_NODE_METRICS_ENABLED=true
OP_NODE_METRICS_ADDR=127.0.0.1
OP_NODE_VERIFIER_L1_CONFS=3
OP_NODE_SEQUENCER_ENABLED=false
OP_NODE_P2P_AGENT=mantle
OP_NODE_P2P_SYNC_REQ_RESP=true
OP_NODE_P2P_PEER_SCORING=light
OP_NODE_P2P_PEER_BANNING=true
OP_NODE_P2P_PRIV_PATH=/config/op-node-priv-key.txt
OP_NODE_P2P_DISCOVERY_PATH=/data/opnode_discovery_db
OP_NODE_P2P_PEERSTORE_PATH=/data/opnode_peerstore_db

### op-node P2P (official static peers; listen port from OP_NODE_P2P_PORT in compose) ###
OP_NODE_P2P_LISTEN_IP=0.0.0.0
OP_NODE_P2P_ADVERTISE_IP=
OP_NODE_P2P_STATIC=/dns4/peer0.mantle.xyz/tcp/9003/p2p/16Uiu2HAmKVKzUAns2gLhZAz1PYcbnhY3WpxNxUZYeTN1x29tNBAW,/dns4/peer1.mantle.xyz/tcp/9003/p2p/16Uiu2HAm1AiZtVp8f5C8LvpSTAXC6GtwqAVKnB3VLawWYSEBmcFN,/dns4/peer2.mantle.xyz/tcp/9003/p2p/16Uiu2HAm2UHVKiPXpovs8VbbUQVPr7feBAqBJdFsH1z5XDiLEvHT

