# macOS hidden files
.DS_Store
._*

# Environment variables
.env

# Engine API JWT secrets
**/jwt.hex
**/jwt.txt
**/op-node-priv-key.txt

# ZK Stack external node generated secrets
**/consensus_secrets.yaml

# Data directories and logs
logs/
*.log

# Python bytecode from scripts/lib
**/__pycache__/
*.pyc

# Local “pinned vs latest” audit cache (timestamps + notes). Not source of truth.
scripts/.client-audit-cache.json

# Cursor canvases (host evidence / audit tables). Local only — never commit.
**/*.canvas.tsx
**/*.canvas.data.json
**/*.canvas.status.json

# Planned chain configs (uncommitted for now)
0g/
hyperliquid/
mantle/
henesys/

# Hedera: generated secrets and bootstrap artifacts (not the chain directory itself)
hedera/bootstrap.env
hedera/config/application.yml
hedera/config/init.sh
hedera/config/.init.version
hedera/bootstrap-logs/
hedera/db-export/
hedera/secrets-backups/

# Hyperliquid
override_gossip_config.json

# Docker specific
target/
target-native/
.dockerignore
!hedera/.dockerignore
