# Zircuit mainnet legacy (zircuit1/l2-geth + zircuit1/op-node)
#
# Pre-Conduit stack. Mainnet migrated to Conduit in Aug 2026 — use ../zircuit/ for
# current mainnet. This setup is for operators with an existing l2-geth datadir/snapshot.
#
# Setup:
#   1. ./configure.sh          # .env, EXT_IP, config/jwt.hex
#   2. Restore external Liquify lz4 snapshot into HOST_DATADIR (see README)
#   3. docker compose up -d
#
# Chain ID 48900.

### Images ###
L2_GETH_IMAGE=zircuit1/l2-geth:v1.132.6
OP_NODE_IMAGE=zircuit1/op-node:v1.132.6

### Network ###
EXT_IP=

### Host paths ###
HOST_DATADIR=$HOME/zircuit-data

### Ports ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=11585
WS_PORT=11586
OP_NODE_P2P_PORT=18688

### RPC ###
GAS_CAP=600000000
SEQUENCER_HTTP=https://mainnet.zircuit.com

### L1 (host.docker.internal when L1 runs on the Docker host) ###
ETHEREUM_MAINNET_BEACON_REST=http://host.docker.internal:5052
ETHEREUM_MAINNET_BEACON_ARCHIVER=http://host.docker.internal:5052
ETHEREUM_MAINNET_EXECUTION_RPC=http://host.docker.internal:8545
ETHEREUM_MAINNET_EXECUTION_KIND=basic
ETHEREUM_MAINNET_EXECUTION_TRUST=true

### op-node ###
OP_NODE_L2_ENGINE_AUTH=/config/jwt.hex
OP_NODE_L2_ENGINE_RPC=http://zircuit-historical-op-geth:8551
OP_NODE_L2_SKIP_SYNC_START_CHECK=true
OP_NODE_LOG_LEVEL=info
OP_NODE_METRICS_ADDR=0.0.0.0
OP_NODE_METRICS_ENABLED=true
OP_NODE_METRICS_PORT=7300
OP_NODE_NETWORK=mainnet
OP_NODE_P2P_LISTEN_IP=0.0.0.0
OP_NODE_P2P_STATIC=/dns4/node1-eu-p2p.mainnet.zircuit.com/tcp/9003/p2p/16Uiu2HAm5Uxn3E8RXEM2e5YsR9VNM8uKoPmZzwQjqp7r64ZLspd5,/dns4/node2-eu-p2p.mainnet.zircuit.com/tcp/9003/p2p/16Uiu2HAmPoLg64PL2X2oLrUSmYaqAbkATPAMNRxLCZTBavUP8UEB,/dns4/node3-eu-p2p.mainnet.zircuit.com/tcp/9003/p2p/16Uiu2HAmB9iZKfv9RPRZj6JwcwjbwZWECFwJ67b1LJMHrczTnbjf
OP_NODE_ROLLUP_LOAD_PROTOCOL_VERSIONS=true
OP_NODE_RPC_ADDR=0.0.0.0
OP_NODE_RPC_PORT=8545
OP_NODE_SEQUENCER_ENABLED=false
OP_NODE_SEQUENCER_L1_CONFS=0
OP_NODE_SEQUENCER_MAX_SAFE_LAG=0
OP_NODE_SEQUENCER_STOPPED=false
OP_NODE_SNAPSHOT_LOG=/tmp/op-node-snapshot-log
OP_NODE_SYNCMODE=consensus-layer
OP_NODE_VERIFIER_L1_CONFS=0
