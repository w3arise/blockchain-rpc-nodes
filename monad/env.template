# Monad mainnet public full node (bare metal, systemd).
#
# Setup (on the Linux host, as root):
#   1. cp env.template .env
#   2. Set NODE_NAME and TRIEDB_DRIVE
#   3. ./configure.sh
#   4. Follow README.md
#
# Config and chain data live under /home/monad on the host (not in this repo).

### Network ###
NETWORK=mainnet
CHAIN=monad_mainnet
MONAD_VERSION=0.15.1

### Node identity (public full node) ###
# Must be unique across the network. Official format: full_<provider>-<suffix>
NODE_NAME=full_<provider>-1
BENEFICIARY=0x0000000000000000000000000000000000000000

### Host paths ###
MONAD_HOME=/home/monad
MF_BUCKET=https://bucket.monadinfra.com

### TrieDB (dedicated NVMe — verify with lsblk before formatting) ###
# Whole device (e.g. /dev/nvme1n1) or an existing partition (e.g. /dev/nvme1n1p1).
# init-triedb.sh prompts for this and writes the confirmed choice back here.
TRIEDB_DRIVE=/dev/nvme1n1

### Ports ###
P2P_PORT=8000
P2P_AUTH_PORT=8001
RPC_PORT=8080
# monad-rpc binds localhost by default; use a firewall or systemd override for LAN/public access
RPC_BIND_ADDR=127.0.0.1

### Public IP (filled by configure.sh) ###
EXT_IP=

### Remote config (auto-fetched on startup, v0.12.1+) ###
REMOTE_VALIDATORS_URL=https://bucket.monadinfra.com/validators/mainnet/validators.toml
REMOTE_FORKPOINT_URL=https://bucket.monadinfra.com/forkpoint/mainnet/forkpoint.toml

### Artifact retention (monad-cruft, minutes) ###
RETENTION_LEDGER=600
RETENTION_WAL=300
RETENTION_FORKPOINT=300
RETENTION_VALIDATORS=43200

### Keystore (generated by configure.sh if empty) ###
KEYSTORE_PASSWORD=
