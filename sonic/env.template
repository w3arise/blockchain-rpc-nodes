# Sonic mainnet RPC node (sonicd)
# ./configure.sh creates .env, sets EXT_IP, and creates the datadir.
# ./sonic-init.sh downloads genesis when chaindata and carmen are absent.
#
# Setup:
#   1. ./configure.sh
#   2. docker compose build
#   3. ./sonic-init.sh
#   4. docker compose up -d
#
# Docs: https://docs.soniclabs.com/sonic/node-deployment/archive-node
# Client: https://github.com/0xsoniclabs/sonic
# Genesis: https://genesis.soniclabs.com/

# Public IP for P2P advertisement (--nat extip); required for incoming peers
EXT_IP="<YOUR_PUBLIC_IP>"

### Genesis ###
# Official prime file, downloaded by ./sonic-init.sh. Pruned history covers the epoch in that file.
# Full history: https://genesis.soniclabs.com/latest-sonic-archive.g
# sonic-init.sh writes GENESIS_FILE to the downloaded path. The archive is kept.
GENESIS_URL=https://genesis.soniclabs.com/latest-sonic-pruned.g

### Sonic release (0xsoniclabs/sonic) — baked into local image at build time ###
SONIC_VERSION=2.2.5

### Host paths ###
# Chain data (docker volume mount target inside container: /data)
HOST_DATADIR=$HOME/sonic-data

### Ports (host; network_mode: host) ###
# sonicd binds these addresses directly on the host
HTTP_ADDR=0.0.0.0
HTTP_PORT=18545
WS_ADDR=0.0.0.0
WS_PORT=18546
MAX_PEERS=32

### RPC ###
# debug and trace are omitted. A custom JavaScript tracer on debug_trace* can corrupt
# memory and run code on the host. Do not add them back until Sonic ships a verified fix.
# If tracing is required before then, expose it only to trusted clients.
HTTP_API=eth,web3,net,txpool,abft,dag
WS_API=eth,web3,net,txpool,abft,dag
GAS_CAP=600000000
TX_FEE_CAP=0

### Performance ###
GOMEMLIMIT=32GiB
CACHE_MB=24000
# Container mem_limit (must exceed GOMEMLIMIT and CACHE_MB)
MEM_LIMIT=42g
