# Plume mainnet archive node (Arbitrum Nitro / Conduit Orbit, AnyTrust DA)
#
# Setup:
#   1. cp env.template .env
#   2. Set L1_ETH_URL and L1_ETH_BEACON_URL (synced Ethereum mainnet)
#   3. mkdir/chown datadir — see README.md
#   4. docker compose up -d
#
# Refresh config/chainInfo.json from https://assets.plume.org/mainnet/chainInfo.json
# after Plume network upgrades (see Plume changelog).

### Image ###
NITRO_IMAGE=offchainlabs/nitro-node:v3.9.5-66e42c4-validator

### Network ###
CHAIN_ID=98866
CHAIN_NAME=conduit-orbit-deployer
FEED_URL=wss://relay-plume-mainnet-1.t.conduit.xyz
REST_AGGREGATOR_URL=https://das-plume-mainnet-1.t.conduit.xyz
FORWARDING_TARGET=https://rpc.plume.org

### Host paths ###
HOST_DATADIR=$HOME/plume-data

### Ports (host → container WS 8547 / metrics 6070) ###
RPC_BIND_ADDR=127.0.0.1
WS_PORT=8547
METRICS_PORT=6070

### Layer 1 (Ethereum mainnet) — required for blobs and AnyTrust DA ###
L1_ETH_URL=
L1_ETH_BEACON_URL=

### RPC ###
HTTP_API=net,web3,eth,txpool,debug,admin,arb,arbdebug,arbtrace
WS_API=net,web3,eth,txpool,debug
TX_FEE_CAP=100
GAS_CAP=500000000

### State retention (hash archive) ###
STATE_SCHEME=hash
