# Robinhood Chain mainnet archive node (Arbitrum Nitro)
# Requires synced Ethereum L1 execution + beacon endpoints.
# cp env.template .env && docker compose up -d

NITRO_IMAGE=offchainlabs/nitro-node:v3.12.4-960ca0a-stripped

### Ports ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=8847
WS_PORT=8848

HTTP_API=net,web3,eth,arb
WS_API=net,web3,eth,arb

# Layer 1 (Ethereum) — required for blob data availability
L1_ETH_URL=
L1_ETH_BEACON_URL=

CHAIN_ID=4663
# Comma-separated sequencer feeds, no spaces; all read at once (dual-primary, deduplicated).
# Default: main feed + delayed backup feed (~500ms behind).
# https://docs.robinhood.com/chain/run-a-full-node/#recommended-run-both-feeds-simultaneously
FEED_URLS=wss://feed.mainnet.chain.robinhood.com,wss://delayed-feed.mainnet.chain.robinhood.com
# Forwards eth_sendRawTransaction to the Robinhood sequencer (required on non-sequencer nodes).
FORWARDING_TARGET=https://sequencer.mainnet.chain.robinhood.com

TX_FEE_CAP=90000000000000
GAS_CAP=90000000000000
STATE_SCHEME=path
# 0 = unlimited (archive). Non-zero prunes history — see README and AGENTS.md.
STATE_HISTORY=0

# Optional first-run snapshot (empty datadir only). Remove after init.
# INIT_URL=

### Feed relay (optional, docker-compose.relay.yml) ###
FEED_RELAY_IMAGE=offchainlabs/nitro-node:v3.12.4-960ca0a-stripped
# Upstream feed(s) the relay reads (comma-separated). Separate from FEED_URLS so the node can point at the relay.
FEED_RELAY_INPUT_URL=wss://feed.mainnet.chain.robinhood.com
# Set 0.0.0.0 only when other hosts should read the relay.
FEED_RELAY_BIND_ADDR=127.0.0.1
FEED_RELAY_PORT=9642
