# Hedera mainnet JSON-RPC Relay + self-hosted Mirror Node
# ./configure.sh, fill the GCP/operator values below, then follow README.md.

### Versions ###
# The initial Mirror Node version must match MIRRORNODE_VERSION.gz in the
# database export. The current published minimal mainnet export is 0.156.0.
MIRROR_NODE_VERSION=0.156.0
RELAY_VERSION=0.78.1
MIRROR_POSTGRES_IMAGE=gcr.io/mirrornode/postgres:16-alpine
MIRROR_PROXY_IMAGE=nginx:1-alpine
MIRROR_REDIS_IMAGE=redis:6-alpine
RELAY_REDIS_IMAGE=redis@sha256:9c6bb76658f8e6f7ca8d0d96c8fcdfb12e9795579c89918aea4fa2ad9817c2f0

### PostgreSQL (steady-state, Hedera database guide) ###
# Passed to postgres via -c flags in docker-compose.yml. For bulk import tuning,
# see README step 4 (temporary max_wal_size raise); do not change these for import.
PG_CHECKPOINT_TIMEOUT=30min
PG_LOG_AUTOVACUUM_MIN_DURATION=30s
PG_LOG_CHECKPOINTS=on
PG_LOG_CONNECTIONS=on
PG_LOG_DISCONNECTIONS=on
PG_LOG_LOCK_WAITS=on
PG_MAINTENANCE_WORK_MEM=2GB
PG_MAX_CONNECTIONS=600
PG_MAX_PARALLEL_MAINTENANCE_WORKERS=8
PG_MAX_WAL_SIZE=24GB
PG_RANDOM_PAGE_COST=1.1
PG_WORK_MEM=50MB

### Network ###
COMPOSE_PROJECT_NAME=hedera
CHAIN_ID=0x127
HEDERA_NETWORK=mainnet

### Host data ###
HOST_DB_DATADIR=$HOME/hedera-postgres-data
HOST_MIRROR_REDIS_DATADIR=$HOME/hedera-mirror-redis-data
HOST_RELAY_REDIS_DATADIR=$HOME/hedera-relay-redis-data
HOST_BOOTSTRAP_DATADIR=$HOME/hedera-bootstrap-data

### Ports ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=7546
WS_PORT=8546
WS_HEALTH_PORT=8547
MIRROR_API_PORT=8080

### GCP requester-pays access ###
# GCP_PROJECT_ID must have billing enabled. Authenticate gcloud separately.
# The HMAC key is used by the live Mirror Node importer.
GCP_PROJECT_ID=
GCP_ACCESS_KEY=
GCP_SECRET_KEY=

### Relay operator ###
# Required for eth_sendRawTransaction. Set READ_ONLY=true to disable writes.
OPERATOR_ID_MAIN=
OPERATOR_KEY_MAIN=
OPERATOR_KEY_FORMAT=DER
READ_ONLY=false

### Relay RPC ###
SERVER_PORT=7546
WEB_SOCKET_PORT=8546
WEB_SOCKET_HTTP_PORT=8547
SUBSCRIPTIONS_ENABLED=true
DEBUG_API_ENABLED=true
FILTER_API_ENABLED=true
TXPOOL_API_ENABLED=false
ETH_GET_LOGS_BLOCK_RANGE_LIMIT=10000
CONTRACT_CALL_GAS_LIMIT=50000000
LOG_LEVEL=info
PRETTY_LOGS_ENABLED=false
RATE_LIMIT_DISABLED=true

### PostgreSQL/bootstrap secrets ###
# configure.sh replaces every GENERATE value with a random secret.
POSTGRES_PASSWORD=GENERATE
GRAPHQL_PASSWORD=GENERATE
GRPC_PASSWORD=GENERATE
IMPORTER_PASSWORD=GENERATE
OWNER_PASSWORD=GENERATE
REST_PASSWORD=GENERATE
REST_JAVA_PASSWORD=GENERATE
ROSETTA_PASSWORD=GENERATE
WEB3_PASSWORD=GENERATE

### Bootstrap tuning ###
BOOTSTRAP_JOBS=8
DECOMPRESSOR_THREADS=4
