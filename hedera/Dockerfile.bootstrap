# Official golang images set GOTOOLCHAIN=local. auto downloads a newer
# toolchain when go.mod is ahead of the image (v0.162.0 needs >= 1.26.7).
FROM golang:1.26-bookworm AS builder
ENV GOTOOLCHAIN=auto

ARG MIRROR_NODE_VERSION

RUN test -n "${MIRROR_NODE_VERSION}"

WORKDIR /src
RUN git clone --depth 1 --branch "v${MIRROR_NODE_VERSION}" \
      https://github.com/hiero-ledger/hiero-mirror-node.git .

WORKDIR /src/tools/bootstrap
RUN go build -o /bootstrap .

FROM debian:bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    gzip \
    postgresql-client \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /bootstrap /usr/local/bin/bootstrap

WORKDIR /work
ENTRYPOINT ["bootstrap"]
