hiero:
  mirror:
    importer:
      network: MAINNET
      downloader:
        cloudProvider: "GCP"
      # HIP-513 sidecars: runtime bytecode, init code, state changes, traces.
      # persistBytes stays off — that flag only stores the raw sidecar blob.
      parser:
        record:
          sidecar:
            enabled: true
      db:
        host: db
        name: mirror_node
        owner: mirror_node
        port: 5432
        restUsername: mirror_api
        sslMode: disable
        username: mirror_importer
      retention:
        enabled: false
    rest:
      db:
        host: db
        name: mirror_node
        port: 5432
        sslMode: DISABLE
        username: mirror_api
      redis:
        enabled: true
        uri: redis://mirror-redis:6379
    restJava:
      db:
        host: db
        name: mirror_node
        port: 5432
        sslMode: DISABLE
        username: mirror_rest_java
    web3:
      db:
        host: db
        name: mirror_node
        port: 5432
        sslMode: DISABLE
        username: mirror_web3
