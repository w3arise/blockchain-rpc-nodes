# XDC mainnet RPC — XDPoSChain (hash-full / option C: full receipts/logs, pruned state)
# cp env.template .env and configure before running
#
# Setup (snapshot — preferred):
#   1. ./configure.sh
#   2. docker compose pull
#   3. ./restore-snapshot.sh
#   4. docker compose up -d
#
# Setup (genesis / P2P — slow):
#   1. ./configure.sh
#   2. docker compose pull
#   3. ./init-database.sh
#   4. docker compose up -d
#
# Docs: https://docs.xdc.network/xdcchain/developers/node_operators/masternode/
# Client: https://github.com/XinFinOrg/XDPoSChain
# Node compose reference: https://github.com/XinFinOrg/XinFin-Node
# Snapshots: https://rpc.xdc.network/snapshots/

### Network ###
# Public IP for P2P advertisement (--nat extip); required for incoming peers
EXT_IP=
NETWORK=mainnet
NETWORK_ID=50
INSTANCE_NAME=xdc-rpc

### Client image (xinfinorg/xdposchain) ###
XDC_VERSION=v2.7.1

### Host paths ###
# Chain data (container --datadir=/data → host .../XDC/chaindata)
HOST_DATADIR=$HOME/xdc-data

### Ports ###
RPC_BIND_ADDR=127.0.0.1
# Community defaults (XinFin-Node RPC guides use 8989 / 8888)
HTTP_PORT=8989
WS_PORT=8888
P2P_PORT=30101

### Sync / retention (hash-full) ###
# Option C: GC_MODE=full keeps blocks/receipts/logs; prunes old state (~128 blocks).
# Use GC_MODE=archive only when historical state (eth_call / eth_getBalance at old blocks) is required.
SYNC_MODE=full
GC_MODE=full
# Epoch reward storage — leave false to save disk on RPC nodes
STORE_REWARD=false
MAX_PEERS=50
VERBOSITY=3

### Snapshot (restore-snapshot.sh) ###
# Official mainnet full-node snapshot (hash-full; ~859 GB download — plan ≥1.5–2 TB disk).
# Listing: https://rpc.xdc.network/snapshots/mainnet/full/
SNAPSHOT_URL=https://rpc.xdc.network/snapshots/mainnet/full/mainnet_full_latest.tar

### RPC ###
HTTP_API=eth,net,web3,txpool,XDPoS
WS_API=eth,net,web3,txpool,XDPoS
ALLOWED_ORIGINS=*
RPC_VHOSTS=*
# Accept 0x-prefixed addresses (Ethereum tooling) in addition to xdc-prefix
ENABLE_0X_PREFIX=true
GAS_CAP=600000000
