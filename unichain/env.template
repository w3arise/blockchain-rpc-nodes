# Unichain mainnet rollup node (op-reth + op-node)
#
# Setup:
#   1. ./configure.sh                 # create .env, set public IP, mkdir datadirs
#   2. Edit .env: OP_NODE_L1_ETH_RPC, OP_NODE_L1_BEACON
#   3. ./create-jwt.sh
#   4. docker compose up -d
#
# Built-in superchain presets — no local genesis/rollup files.
# Chain spec: op-reth --chain=unichain, op-node OP_NODE_NETWORK=unichain-mainnet
# Chain ID 130. Signed txs go to https://mainnet-sequencer.unichain.org
# Official node repo: https://github.com/Uniswap/unichain-node

### Images ###
OP_RETH_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-reth:v2.5.0
OP_NODE_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:v1.19.8

### Network ###
# Public IP for P2P advertisement (--nat extip / OP_NODE_P2P_ADVERTISE_IP)
EXT_IP="<YOUR_PUBLIC_IP>"

### Host paths ###
HOST_DATADIR=$HOME/unichain-op-reth-data
HOST_OP_NODE_DATADIR=$HOME/unichain-op-node-data

### Ports (host → container 8545 / 8546 / op-node RPC) ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=9541
WS_PORT=9542
OP_NODE_RPC_PORT=9543
OP_NODE_P2P_PORT=9230
P2P_PORT=10405

### RPC ###
GAS_CAP=600000000

