# Sei mainnet historical RPC node (seid) — Option A
# Full block + EVM receipt/log history; pruned state (~100k SS versions).
# cp env.template .env and configure before running
#
# Setup:
#   1. ./configure.sh
#   2. ./init-database.sh
#   3. ./restore-snapshot.sh        # preferred — latest Polkachu snapshot (repo exception)
#   4. ./patch-config.sh            # MUST run after restore (min-retain-blocks=0)
#   5. docker compose up -d
#
# Snapshot: this repo accepts Polkachu for Sei despite their ~100-block app prune.
# Other official providers: Imperator, Stakeme, kjnodes (https://docs.sei.io/node/snapshot).
#
# Docs: https://docs.sei.io/node
# Client: https://github.com/sei-protocol/sei-chain

### Network ###
CHAIN_ID=pacific-1
MONIKER=sei-rpc

# Public IP for P2P advertisement (external_address); required for incoming peers
EXT_IP=

### Host user (container runs as your uid/gid) ###
# Set by ./configure.sh — update .env and recreate the container if your uid/gid changes
BUILD_UID=1000
BUILD_GID=1000

### seid release (ghcr.io/sei-protocol/sei) ###
# v6.4.2+ required — fixes receipt pruning honoring min-retain-blocks (v6.4.0 bug)
SEID_VERSION=v6.4.2

### Host paths ###
# Chain home (config/, data/, wasm/); in-container --home /data
# HOST_DATADIR=$HOME/sei-data

### Ports ###
# EVM / Tendermint / Cosmos API bind on localhost by default
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=8545
WS_PORT=8546
TM_RPC_PORT=26657
API_PORT=1317
GRPC_PORT=9090
# CometBFT P2P (TCP + UDP), public
P2P_PORT=26656

### app.toml / config.toml (applied by patch-config.sh) ###
# Option A: retain all blocks + receipts; prune state store to recent ~100k versions
MIN_RETAIN_BLOCKS=0
SS_KEEP_RECENT=100000
MINIMUM_GAS_PRICES=0.02usei
# CometBFT tx indexer — keep "kv" for historical tx lookups
INDEXER=kv
# Production RPC tuning from Sei docs
CONCURRENCY_WORKERS=500
# eth_call / estimateGas simulation cap (repo default; Sei block gas limit is 12.5M)
GAS_CAP=600000000
# eth_getLogs block-range cap per request (raise if wide queries are expected)
MAX_BLOCKS_FOR_LOG=2000

### Peers (config.toml persistent-peers) ###
# State-sync service peers (mainnet); add more from https://docs.sei.io/node
PERSISTENT_PEERS=3be6b24cf86a5938cce7d48f44fb6598465a9924@p2p.state-sync.pacific-1.seinetwork.io:26656,b21279d7092fde2e41770832a1cacc7d0051e9dc@p2p.state-sync-1.pacific-1.seinetwork.io:26656,616c05e9ba24acc89c0de630b5e3adbedaebb478@p2p.state-sync-2.pacific-1.seinetwork.io:26656

### Snapshots (restore-snapshot.sh) ###
# Default: latest from Polkachu (https://www.polkachu.com/tendermint_snapshots/sei).
# Repo exception — Polkachu snapshots use heavy app pruning (~100 blocks) but are
# accepted for Sei bootstrap; patch-config applies min-retain-blocks=0 afterward.
# Override with another provider from https://docs.sei.io/node/snapshot if needed.
# SNAPSHOT_URL=
# POLKACHU_SNAPSHOT_PAGE=https://www.polkachu.com/tendermint_snapshots/sei
# SNAPSHOT_TMPDIR=$HOME/sei-snapshot-tmp
