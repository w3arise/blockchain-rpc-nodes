# Hyperliquid non-validator (hl-visor) + optional pruner
#
# Setup:
#   1. ./configure.sh
#   2. docker compose build
#   3. sudo chown -R 10000:10000 $HOST_DATADIR   # first start only
#   4. docker compose up -d
#
# Docs: https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/nodes
# Upstream: https://github.com/hyperliquid-dex/node

### Host paths ###
HOST_DATADIR=$HOME/hyperliquid-data

### Ports ###
# Container HTTP listen is fixed at 3001 (/evm and /info). No websocket server.
# Gossip TCP 4001 and 4002 are fixed by hl-visor and published on all interfaces.
HTTP_PORT=3001
RPC_BIND_ADDR=127.0.0.1

### Gossip ###
# Comma-separated IPs prepended to gossip roots and set as reserved_peer_ips.
# ./override-gossip.sh keeps an address only when TCP 4001 accepts a connection.
RESERVED_PEER_IPS=142.132.131.162,185.252.220.90,173.231.43.98,136.243.70.112,72.46.87.141,136.243.40.153,180.189.55.18,199.254.199.12,85.25.187.89,180.189.55.19,167.254.243.52,109.123.230.10,52.195.133.97,206.223.231.119,136.243.54.160,66.248.240.187,5.223.56.103,23.88.72.87
# Target gossip peer count written to override_gossip_config.json (8-100).
N_GOSSIP_PEERS=50
# Optional override for the curated seed roots (default: upstream node README table).
SEED_PEER_IPS=

### Runtime ###
# Stack size in bytes for threads spawned by hl-visor / hl-node (inherited by the child).
# The Rust default (2 MiB) overflows while hl-node loads a peer ABCI state.
RUST_MIN_STACK=134217728

### Pruner sidecar ###
PRUNE_RETENTION_HOURS=48

### Image build (hl-visor binary URLs; rebuild after bump) ###
HL_VISOR_URL=https://binaries.hyperliquid.xyz/Mainnet/hl-visor
HL_VISOR_ASC_URL=https://binaries.hyperliquid.xyz/Mainnet/hl-visor.asc
PUB_KEY_URL=https://raw.githubusercontent.com/hyperliquid-dex/node/refs/heads/main/pub_key.asc
