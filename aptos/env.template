# Aptos mainnet public fullnode (aptos-node)
# cp env.template .env && ./configure.sh && docker compose up -d
#
# Mainnet genesis and waypoint: aptos-labs/aptos-networks (main/mainnet/)
# Node image: https://hub.docker.com/r/aptoslabs/validator/tags

APTOS_IMAGE=aptoslabs/validator:aptos-node-v1.48.5-hotfix

# Host path for chain data (rocksdb under data_dir)
# Leave unset to use $HOME/aptos-data (resolved when you run docker compose)
# HOST_DATADIR=$HOME/aptos-data

### Ports ###
# Host bind for REST API and metrics (P2P binds on all interfaces)
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=8080
METRICS_PORT=9101
# Public PFN P2P (TCP; container listen is fixed at 6182)
P2P_PORT=6182
