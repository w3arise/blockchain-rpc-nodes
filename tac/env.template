# Tac mainnet full RPC node (tacchaind)
# cp env.template .env and configure before running
#
# Setup:
#   1. ./configure.sh
#   2. docker compose build
#   3. ./init-database.sh
#   4. ./restore-snapshot.sh   # preferred: Ankr full (skip for genesis sync)
#   5. ./patch-config.sh
#   6. docker compose up -d
#
# Snapshot preference (AGENTS.md): Ankr full → Ankr archive → Polkachu last resort.
#
# Docs: https://github.com/TacBuild/tacchain/blob/main/NETWORKS.md
# Client: https://github.com/TacBuild/tacchain

### Network ###
CHAIN_ID=tacchain_239-1
MONIKER=tac-rpc

# Public IP for P2P advertisement (external_address); required for incoming peers
EXT_IP=

### Host user (baked into image at build time) ###
# Set by ./configure.sh — re-run configure + docker compose build if your uid/gid changes
BUILD_UID=1000
BUILD_GID=1000

### tacchaind release (TacBuild/tacchain) — baked into local image at build time ###
# Pins the GitHub release tarball and the local Docker tag (tacchaind:<version>).
TACCHAIN_VERSION=1.6.0

### Host paths ###
# Chain data (docker volume mount target inside container: /data); --home /data
# Leave unset to use $HOME/tac-data (resolved when you run docker compose / scripts)
# HOST_DATADIR=$HOME/tac-data

### Ports ###
# JSON-RPC / Tendermint RPC / Cosmos API bind on localhost by default
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=8545
WS_PORT=8546
TM_RPC_PORT=26657
API_PORT=1317
GRPC_PORT=9090
# CometBFT P2P (TCP + UDP), public
P2P_PORT=26656

### app.toml / config.toml (applied by patch-config.sh) ###
# default = full block history, pruned app state (preferred for receipts/logs RPC)
# nothing = archive (full state history)
PRUNING=default
MINIMUM_GAS_PRICES=25000000000utac
# CometBFT tx indexer — keep "kv" for historical tx lookups (Polkachu uses "null")
INDEXER=kv
LOGS_CAP=100000
BLOCK_RANGE_CAP=100000
# eth_call / estimateGas cap (repo default 600M)
GAS_CAP=600000000

### Peers (config.toml persistent_peers) ###
# From TacBuild networks/tacchain_239-1/.env.mainnet
PERSISTENT_PEERS=d0a80c43a10a6b60475864728db6d9ba4ead42d2@107.6.113.60:58960,10550a03e4f7fa487c78fbd07e0770e2b0f085c7@64.46.115.78:58960,0efae9d157f0ef60ad7d25507d6939799f832e34@69.4.239.26:58960,78079166d06e345dbf4a5c932ee3c69a04148e92@107.6.91.38:58960

### Snapshots (restore-snapshot.sh) ###
# full (default) = block history; archive = full state. Override URL if needed.
SNAPSHOT_TYPE=full
# SNAPSHOT_URL=http://snapshot.tac.ankr.com/tac-mainnet-full-latest.tar.lz4
# SNAPSHOT_TMPDIR=$HOME/tac-snapshot-tmp
