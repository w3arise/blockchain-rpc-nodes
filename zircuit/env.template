# Zircuit mainnet (op-reth + op-node) — Conduit infrastructure
#
# Zircuit mainnet migrated to Conduit (Aug 2026). Legacy zircuit1/l2-geth setups
# and bootstrap.mainnet.zircuit.com are no longer maintained for mainnet.
#
# Setup:
#   1. ./configure.sh                 # create .env and set EXT_IP / P2P advertise IP
#   2. Edit .env: OP_NODE_L1_ETH_RPC, OP_NODE_L1_BEACON; optional HISTORICAL_RPC, SEQUENCER_HTTP
#   3. ./create-jwt.sh
#   4. ./restore-snapshot.sh          # required; Conduit GCS snapshot
#   5. docker compose up -d
#
# Chain ID 48900. Conduit slug: zircuit-mainnet
# config/rollup.json anchors derivation at L2 block 32956468 (Conduit migration point), so op-node
# refuses to start unless op-reth already has that block: a snapshot restore is required.
# Historical RPC cutoff is --rollup.historicalrpc.block=32956468 (that block stays on op-reth).
# Published genesis keeps bedrockBlock: 0 and conduit.migrationBlock: 32956469.

### Images ###
OP_RETH_IMAGE=ghcr.io/conduitxyz/conduit-op-reth:v2.3.1
OP_NODE_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:v1.19.11

### Network ###
# Public IP for P2P advertisement (--nat extip / OP_NODE_P2P_ADVERTISE_IP)
EXT_IP=<YOUR_PUBLIC_IP>

### Host paths ###
HOST_DATADIR=$HOME/zircuit-op-reth-data
HOST_OP_NODE_DATADIR=$HOME/zircuit-op-node-data

### Ports (host → container 8545 / 8546 / op-node RPC) ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=11585
WS_PORT=11586
OP_NODE_RPC_PORT=11587
OP_NODE_P2P_PORT=9228
P2P_PORT=11588

### RPC ###
GAS_CAP=600000000

### op-reth rollup (Conduit sequencer / public RPC) ###
SEQUENCER_HTTP=https://mainnet.zircuit.com
# Pre-fork history (blocks below 32956468). Compose sets --rollup.historicalrpc.block=32956468.
# Local legacy archive: http://host.docker.internal:11565 or http://172.17.0.1:11565
HISTORICAL_RPC=https://mainnet.zircuit.com

### Snapshot restore (required; requester-pays GCS) ###
GCP_PROJECT=
SNAPSHOT_NETWORK=zircuit-mainnet
SNAPSHOT_TMPDIR=$HOME/zircuit-snapshot-tmp

### op-reth P2P (execution layer) ###
# One trusted peer from https://api.conduit.xyz/public/network/elPeers/zircuit-mainnet
# There is no EL discovery mesh. A peer count of 1 is expected.
# Trusted, not a bootnode: this peer keeps a rolling window, and a short answer bans an untrusted peer.
OP_RETH_TRUSTED_PEERS=enode://7d674ac536401198b6f33bf0b01a06b4777e39d6b71976e9ce9c73396638d9953a62865e2722dbd0ccc4b5dba23b1d6949119c9e8c398d0b886938bab0335ea3@8.235.57.247:30303

### op-node L1 ###
# host.docker.internal works when L1 nodes run on the Docker host (Linux: extra_hosts in compose)
OP_NODE_L1_ETH_RPC=<YOUR_L1_ETH_RPC>
OP_NODE_L1_BEACON=<YOUR_L1_BEACON>
OP_NODE_L1_TRUST_RPC=true
OP_NODE_L1_RPC_KIND=standard
OP_NODE_L1_MAX_CONCURRENCY=20
OP_NODE_L1_RPC_MAX_BATCH_SIZE=50

### op-node L2 / rollup ###
OP_NODE_LOG_LEVEL=INFO
OP_NODE_L2_ENGINE_KIND=reth
OP_NODE_L2_ENGINE_AUTH=/config/jwt.hex
OP_NODE_L2_ENGINE_RPC=http://zircuit-op-reth:9551
# Catch-up is execution-layer. op-reth dials OP_RETH_TRUSTED_PEERS.
OP_NODE_SYNCMODE=execution-layer
OP_NODE_ROLLUP_CONFIG=/config/rollup.json
OP_NODE_RPC_ADDR=0.0.0.0
OP_NODE_RPC_ENABLE_ADMIN=true
OP_NODE_SAFEDB_PATH=/data
# Fork overrides from Conduit forkTimestamps (not all in rollup.json)
OP_NODE_OVERRIDE_JOVIAN=1789489801
OP_NODE_OVERRIDE_KARST=1790179201

### op-node P2P (Conduit API slug: zircuit-mainnet) ###
# Static peer: https://api.conduit.xyz/public/network/staticPeers/zircuit-mainnet
# Same host as OP_RETH_TRUSTED_PEERS (CL gossip on 9222, EL devp2p on 30303).
# External nodes have no CL discovery network.
OP_NODE_P2P_LISTEN_IP=0.0.0.0
OP_NODE_P2P_NO_DISCOVERY=true
OP_NODE_P2P_STATIC=/ip4/8.235.57.247/tcp/9222/p2p/16Uiu2HAmKiCKGNiBbHurYYZidW4PgKz4xp8fYEGnv7HMYQMmdA2U
OP_NODE_P2P_ADVERTISE_IP=<YOUR_PUBLIC_IP>
