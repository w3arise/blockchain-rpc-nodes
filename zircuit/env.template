# Zircuit mainnet (l2-geth + op-node)
#
# Setup:
#   1. ./configure.sh                 # create .env and set EXT_IP / P2P advertise IP
#   2. Edit .env: OP_NODE_L1_ETH_RPC, OP_NODE_L1_BEACON, SEQUENCER_HTTP
#   3. ./create-jwt.sh
#   4. ./restore-snapshot.sh          # optional; Liquify lz4 snapshot
#   5. docker compose up -d
#
# Chain ID 48900. Official run guide: https://docs.zircuit.com/build/start/run-zircuit

### Images ###
L2_GETH_IMAGE=zircuit1/l2-geth:v1.132.6
OP_NODE_IMAGE=zircuit1/op-node:v1.132.6

### Network ###
# Public IP for op-node P2P advertisement (filled by configure.sh)
EXT_IP=

### Host paths ###
HOST_DATADIR=$HOME/zircuit-l2-geth-data
HOST_OP_NODE_DATADIR=$HOME/zircuit-op-node-data

### Ports (host → container 8545 / 8546 / op-node RPC) ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=11585
WS_PORT=11586
OP_NODE_RPC_PORT=11587
OP_NODE_P2P_PORT=18688

### RPC ###
GAS_CAP=600000000

### l2-geth rollup ###
# Sequencer ingress URL (include token query param if your endpoint requires it)
SEQUENCER_HTTP=<YOUR_ZIRCUIT_SEQUENCER_HTTP>

### op-node L1 ###
# host.docker.internal works when L1 nodes run on the Docker host (Linux: extra_hosts in compose)
OP_NODE_L1_ETH_RPC=<YOUR_L1_ETH_RPC>
OP_NODE_L1_BEACON=<YOUR_L1_BEACON>
OP_NODE_L1_BEACON_ARCHIVER=
OP_NODE_L1_RPC_KIND=basic
OP_NODE_L1_TRUST_RPC=false
OP_NODE_L1_MAX_CONCURRENCY=20

### op-node L2 / rollup ###
OP_NODE_LOG_LEVEL=info
OP_NODE_L2_ENGINE_AUTH=/config/jwt.hex
OP_NODE_L2_ENGINE_RPC=http://zircuit-l2-geth:8551
OP_NODE_L2_SKIP_SYNC_START_CHECK=true
OP_NODE_NETWORK=mainnet
OP_NODE_ROLLUP_LOAD_PROTOCOL_VERSIONS=true
OP_NODE_RPC_ADDR=0.0.0.0
OP_NODE_RPC_PORT=11587
OP_NODE_SEQUENCER_ENABLED=false
OP_NODE_SYNCMODE=consensus-layer
OP_NODE_SAFEDB_PATH=/data
OP_NODE_VERIFIER_L1_CONFS=0

### op-node P2P (official mainnet static peers) ###
OP_NODE_P2P_LISTEN_IP=0.0.0.0
OP_NODE_P2P_LISTEN_TCP_PORT=18688
OP_NODE_P2P_LISTEN_UDP_PORT=18688
OP_NODE_P2P_ADVERTISE_IP=
OP_NODE_P2P_STATIC=/dns4/node1-eu-p2p.mainnet.zircuit.com/tcp/9003/p2p/16Uiu2HAm5Uxn3E8RXEM2e5YsR9VNM8uKoPmZzwQjqp7r64ZLspd5,/dns4/node2-eu-p2p.mainnet.zircuit.com/tcp/9003/p2p/16Uiu2HAmPoLg64PL2X2oLrUSmYaqAbkATPAMNRxLCZTBavUP8UEB,/dns4/node3-eu-p2p.mainnet.zircuit.com/tcp/9003/p2p/16Uiu2HAmB9iZKfv9RPRZj6JwcwjbwZWECFwJ67b1LJMHrczTnbjf

### Snapshot restore (restore-snapshot.sh) ###
SNAPSHOT_BASE=https://zircuit-snapshot.liquify.com/files/mainnet
SNAPSHOT_TMPDIR=$HOME/zircuit-snapshot-tmp

