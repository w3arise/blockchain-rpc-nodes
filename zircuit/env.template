# Zircuit mainnet (op-reth + op-node) — Conduit infrastructure
#
# Zircuit mainnet migrated to Conduit (Aug 2026). Legacy zircuit1/l2-geth setups
# and bootstrap.mainnet.zircuit.com are no longer maintained for mainnet.
#
# Setup:
#   1. ./configure.sh                 # create .env and set EXT_IP / P2P advertise IP
#   2. Edit .env: OP_NODE_L1_ETH_RPC, OP_NODE_L1_BEACON, SEQUENCER_HTTP (optional API key)
#   3. ./create-jwt.sh
#   4. ./restore-snapshot.sh          # required; Conduit GCS snapshot
#   5. docker compose up -d
#
# Chain ID 48900. Conduit slug: zircuit-mainnet
# Migration network: config/genesis.json pins bedrockBlock=32956468. Pre-bedrock blocks are
# not derivable from L1, so a snapshot restore is required; SEQUENCER_HTTP serves them via
# --rollup.historicalrpc.
# Run guide: https://docs.conduit.xyz/chains/getting-started/run-a-node/op-stack-nodes

### Images ###
# conduit-op-reth is the client Conduit runs on Zircuit and the one that writes the GCS snapshots
# this setup restores from. v2.1.2 builds on reth v2.3.0 + op-reth v2.4.0 and symlinks op-reth.
OP_RETH_IMAGE=ghcr.io/conduitxyz/conduit-op-reth:v2.1.2
OP_NODE_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:v1.19.4

### Network ###
# Public IP for P2P advertisement (--nat extip / OP_NODE_P2P_ADVERTISE_IP)
EXT_IP=

### Host paths ###
HOST_DATADIR=$HOME/zircuit-op-reth-data
HOST_OP_NODE_DATADIR=$HOME/zircuit-op-node-data

### Ports (host → container 8545 / 8546 / op-node RPC) ###
RPC_BIND_ADDR=127.0.0.1
HTTP_PORT=11585
WS_PORT=11586
OP_NODE_RPC_PORT=11587
# op-node P2P: host mapping and in-container listen (TCP/UDP) both use this port (see docker-compose.yml)
OP_NODE_P2P_PORT=9228
P2P_PORT=11588

### RPC ###
GAS_CAP=600000000

### op-reth rollup (Conduit sequencer / public RPC) ###
# Public URL (alias): https://mainnet.zircuit.com
# Direct Conduit URL: https://rpc-zircuit-mainnet.t.conduit.xyz
# Optional API key (production): https://rpc-zircuit-mainnet.t.conduit.xyz/<key> from https://app.conduit.xyz/nodes
SEQUENCER_HTTP=https://mainnet.zircuit.com

### Snapshot restore (required; requester-pays GCS) ###
GCP_PROJECT=
SNAPSHOT_NETWORK=zircuit-mainnet
SNAPSHOT_TMPDIR=$HOME/zircuit-snapshot-tmp

### op-reth P2P (execution layer) ###
# Conduit publishes no Zircuit execution bootnodes, and mainnet.zircuit.com is a Cloudflare-fronted
# load balancer with admin_nodeInfo disabled, so its enode cannot be retrieved. These are the
# generic OP Stack mainnet bootnodes op-geth ships for every OP Stack chain (params.V5OPBootnodes):
# discv4/discv5 is one shared DHT, so they work as entry points and fork-ID filtering keeps only
# chain-48900 peers. Requires the correct bedrockBlock in config/genesis.json.
OP_RETH_BOOTNODES=enode://ca2774c3c401325850b2477fd7d0f27911efbf79b1e8b335066516e2bd8c4c9e0ba9696a94b1cb030a88eac582305ff55e905e64fb77fe0edcd70a4e5296d3ec@34.65.175.185:30305,enode://dd751a9ef8912be1bfa7a5e34e2c3785cc5253110bd929f385e07ba7ac19929fb0e0c5d93f77827291f4da02b2232240fbc47ea7ce04c46e333e452f8656b667@34.65.107.0:30305,enode://c5d289b56a77b6a2342ca29956dfd07aadf45364dde8ab20d1dc4efd4d1bc6b4655d902501daea308f4d8950737a4e93a4dfedd17b49cd5760ffd127837ca965@34.65.202.239:30305,enode://87a32fd13bd596b2ffca97020e31aef4ddcc1bbd4b95bb633d16c1329f654f34049ed240a36b449fda5e5225d70fe40bc667f53c304b71f8e68fc9d448690b51@3.231.138.188:30301,enode://ca21ea8f176adb2e229ce2d700830c844af0ea941a1d8152a9513b966fe525e809c3a6c73a2c18a12b74ed6ec4380edf91662778fe0b79f6a591236e49e176f9@184.72.129.189:30301,enode://acf4507a211ba7c1e52cdf4eef62cdc3c32e7c9c47998954f7ba024026f9a6b2150cd3f0b734d9c78e507ab70d59ba61dfe5c45e1078c7ad0775fb251d7735a2@3.220.145.177:30301,enode://8a5a5006159bf079d06a04e5eceab2a1ce6e0f721875b2a9c96905336219dbe14203d38f70f3754686a6324f786c2f9852d8c0dd3adac2d080f4db35efc678c5@3.231.11.52:30301,enode://cdadbe835308ad3557f9a1de8db411da1a260a98f8421d62da90e71da66e55e98aaa8e90aa7ce01b408a54e4bd2253d701218081ded3dbe5efbbc7b41d7cef79@54.198.153.150:30301,enode://b1a743328188dba3b2ed8c06abbb2688fabe64a3251e43bd77d4e5265bbd5cf03eca8ace4cde8ddb0c49c409b90bf941ebf556094638c6203edd6baa5ef0091b@3.134.214.169:30303,enode://ea9eaaf695facbe53090beb7a5b0411a81459bbf6e6caac151e587ee77120a1b07f3b9f3a9550f797d73d69840a643b775fd1e40344dea11e7660b6a483fe80e@52.14.30.39:30303,enode://77b6b1e72984d5d50e00ae934ffea982902226fe92fa50da42334c2750d8e405b55a5baabeb988c88125368142a64eda5096d0d4522d3b6eef75d166c7d303a9@3.148.100.173:30303

### op-node L1 ###
# host.docker.internal works when L1 nodes run on the Docker host (Linux: extra_hosts in compose)
OP_NODE_L1_ETH_RPC=<YOUR_L1_ETH_RPC>
OP_NODE_L1_BEACON=<YOUR_L1_BEACON>
OP_NODE_L1_TRUST_RPC=true
OP_NODE_L1_RPC_KIND=standard
OP_NODE_L1_MAX_CONCURRENCY=20
OP_NODE_L1_RPC_MAX_BATCH_SIZE=50

### op-node L2 / rollup ###
OP_NODE_LOG_LEVEL=INFO
OP_NODE_L2_ENGINE_KIND=reth
OP_NODE_L2_ENGINE_AUTH=/config/jwt.hex
OP_NODE_L2_ENGINE_RPC=http://zircuit-op-reth:9551
# consensus-layer derives every block from L1 and pushes it over the Engine API, so it needs no
# op-reth execution peers. execution-layer is faster but stalls without them, and Zircuit publishes
# no execution bootnodes — see "op-reth peers" in README.md.
OP_NODE_SYNCMODE=consensus-layer
OP_NODE_ROLLUP_CONFIG=/config/rollup.json
OP_NODE_RPC_ADDR=0.0.0.0
OP_NODE_RPC_ENABLE_ADMIN=true
OP_NODE_SAFEDB_PATH=/data
OP_NODE_VERIFIER_L1_CONFS=4

### op-node P2P (Conduit API slug: zircuit-mainnet) ###
OP_NODE_P2P_LISTEN_IP=0.0.0.0
OP_NODE_P2P_BOOTNODES=enode://de9f4784612b7523dc029a38091139aafae293c2f7d17c11bce8579f6246782216a7d61599fb001c38042e8e6ac6a0cdafd1a26d37743e5439bc3d4d6680f7df@35.185.208.192:9222?discport=30301,enode://d25ce99435982b04d60c4b41ba256b84b888626db7bee45a9419382300fbe907359ae5ef250346785bff8d3b9d07cd3e017a27e2ee3cfda3bcbb0ba762ac9674@bootnode.conduit.xyz:0?discport=30301,enode://2d4e7e9d48f4dd4efe9342706dd1b0024681bd4c3300d021f86fc75eab7865d4e0cbec6fbc883f011cfd6a57423e7e2f6e104baad2b744c3cafaec6bc7dc92c1@34.65.43.171:0?discport=30305,enode://9d7a3efefe442351217e73b3a593bcb8efffb55b4807699972145324eab5e6b382152f8d24f6301baebbfb5ecd4127bd3faab2842c04cd432bdf50ba092f6645@34.65.109.126:0?discport=30305
OP_NODE_P2P_STATIC=/ip4/35.185.208.192/tcp/9222/p2p/16Uiu2HAmTe1j7ubQUanCiUSQs7K7SzkWxdrfDUP9GifkMoC2osLm
OP_NODE_P2P_SYNC_ONLYREQTOSTATIC=true
OP_NODE_P2P_ADVERTISE_IP=

